# Default: keep the existing local MVP login. No NyxID network requests.
ARENA_AUTH_MODE=local

# Fill these when you connect your own NyxID confidential web client.
# Keep secrets in your deployment environment, never in VITE_* or Git.
ARENA_NYXID_BASE_URL=https://your-nyxid.example
# Exact discovery/JWT issuer; can be a string distinct from the base URL.
ARENA_NYXID_ISSUER=your-exact-issuer
ARENA_NYXID_CLIENT_ID=your-client-id
ARENA_NYXID_CLIENT_SECRET=
ARENA_PUBLIC_ORIGIN=https://your-arena.example
# Registered callback: ${ARENA_PUBLIC_ORIGIN}/api/v1/auth/nyxid/callback
# Shell/launchd must explicitly supply environment variables; arena does not
# automatically load this file. Set ARENA_AUTH_MODE=nyxid only after filling it.

# Required only for scripts/sync_mac.py; keep deployment-specific values out of Git.
ARENA_DEPLOY_HOST=your-nyxid-host
ARENA_DEPLOY_PATH=/path/to/deployment
ARENA_DEPLOY_PRINCIPAL=your-nyxid-principal
